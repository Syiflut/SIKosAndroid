<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- HEADER AREA -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical">

        <!-- Foto Profil Bulat Mini -->
        <View
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="@color/pastel_pink" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selamat datang,"
                android:textColor="#666666"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvNamaPenghuni"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Halo, Fitri Liyani!"
                android:textColor="@color/pastel_blue_dark"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tombol Cari / Filter -->
        <ImageButton
            android:id="@+id/btnFilter"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:backgroundTint="@color/pastel_blue"
            android:contentDescription="Filter Cari"
            android:src="@android:drawable/ic_menu_search" />
    </LinearLayout>

    <!-- INFO RINGKASAN KAMAR & TAGIHAN (Sesuai List Screenshot) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardStatusKos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutHeader"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F3F8FA">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status Kamar Kamu"
                android:textStyle="bold"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/tvInfoKamar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kamar C3 - Kos Alinda"
                android:layout_marginTop="4dp"
                android:textColor="#666666"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginBottom="12dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvTagihan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tagihan: Rp 650.000"
                    android:textStyle="bold"
                    android:textColor="#333333"/>

                <TextView
                    android:id="@+id/tvStatusBayar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="LUNAS"
                    android:textColor="#4CAF50"
                    android:textStyle="bold"/>
            </RelativeLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- DAFTAR KATALOG KAMAR KOSONG -->
    <TextView
        android:id="@+id/tvLabelKatalog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/cardStatusKos"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="12dp"
        android:text="Rekomendasi Kamar Kosong"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/pastel_blue_dark"/>

    <!-- Tempat list kamar kosong nanti (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvKamarKosong"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tvLabelKatalog"
        android:layout_marginHorizontal="12dp"
        android:paddingBottom="80dp"
        android:clipToPadding="false"/>

</RelativeLayout>