<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F6"
    tools:context=".ui.DashboardFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Bagian Atas: Salam Dinamis & Tombol Filter -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selamat datang,"
                    android:textSize="14sp"
                    android:textColor="#888888" />

                <!-- ID INI YANG WAJIB ADA BIAR KOTLIN TIDAK EROR -->
                <TextView
                    android:id="@+id/tvHaloUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Halo, Pengguna!"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#7BB3FF" />
            </LinearLayout>

            <!-- Ikon Filter (Cari Otomatis) -->
            <ImageView
                android:id="@+id/btnFilter"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerInParent="true"
                android:background="#E0F2FE"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#7BB3FF" />
        </RelativeLayout>

        <!-- Informasi Status Kamar Dummy -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status Kamar Kamu"
                android:textStyle="bold"
                android:textColor="#333333"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kamar C3 - Kos Alinda"
                android:textColor="#666666"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tagihan: Rp 650.000"
                    android:textColor="#333333"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="LUNAS"
                    android:textColor="#4ADE80"
                    android:textStyle="bold"/>
            </RelativeLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rekomendasi Kamar Kosong"
            android:textStyle="bold"
            android:textColor="#7BB3FF"
            android:layout_marginBottom="8dp"/>

        <!-- Tempat List Kamar Bawaan Kelompokmu -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvKamarKosong"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:listitem="@android:layout/activity_list_item" />

    </LinearLayout>
</FrameLayout>