<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.tools.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F9FAFC"
    android:padding="24dp">

    <!-- Area Foto Profil -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="24dp">

        <androidx.cardview.widget.CardView
            android:layout_width="90dp"
            android:layout_height="90dp"
            app:cardCornerRadius="45dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/pastel_pink">

            <ImageView
                android:id="@+id/ivFotoProfil"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:padding="18dp"
                android:src="@android:drawable/ic_menu_gallery"
                android:contentDescription="Foto Profil" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- KELOMPOK INFORMASI AKUN -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Baris Nama Lengkap -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nama Lengkap"
                android:textSize="12sp"
                android:textColor="#999999"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tvNamaProfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fitri Liyani"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"
                tools:ignore="HardcodedText" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE" />

            <!-- Baris Alamat Email -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alamat Email"
                android:textSize="12sp"
                android:textColor="#999999"
                android:layout_marginTop="12dp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tvEmailProfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="fitri.liyani@student.utbandung.ac.id"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginTop="2dp"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- TAMBAHAN BARU: Daftar Kos Terfavorit / Dibintangi -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kos Yang Disukai"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/pastel_blue_dark"
        android:layout_marginBottom="8dp"
        tools:ignore="HardcodedText" />

    <!-- RecyclerView akan mengambil sisa ruang tengah yang fleksibel -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvKosFavorit"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp"
        tools:listitem="@layout/item_kamar_kos" />

    <!-- TOMBOL KELUAR AKUN ATUR DI PALING BAWAH -->
    <Button
        android:id="@+id/btnKeluarAkun"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Keluar Akun"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="@color/pastel_pink"
        app:cornerRadius="12dp"
        tools:ignore="HardcodedText" />

</LinearLayout>