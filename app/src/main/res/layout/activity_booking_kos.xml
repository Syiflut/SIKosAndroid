<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Judul Halaman -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Formulir Pengajuan Sewa"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/pastel_blue_dark"
            android:layout_marginBottom="24dp"/>

        <!-- Input Tanggal Masuk -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tanggal Mulai Masuk"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etTanggalMasuk"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Contoh: 15-03-2026"
            android:background="@color/pastel_blue"
            android:paddingHorizontal="16dp"
            android:inputType="date"
            android:layout_marginBottom="20dp"/>

        <!-- Input Durasi Sewa (Bulan) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Durasi Sewa (Bulan)"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etDurasiSewa"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Masukkan jumlah bulan (misal: 3)"
            android:background="@color/pastel_blue"
            android:paddingHorizontal="16dp"
            android:inputType="number"
            android:layout_marginBottom="24dp"/>

        <!-- Sesi Upload KTP -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upload Foto KTP Pemohon"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardUploadKtp"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#F3F8FA"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivPreviewKtp"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_camera"
                    android:backgroundTint="@color/pastel_blue_dark"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Klik untuk pilih/ambil foto KTP"
                    android:textColor="#777777"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tombol Kirim Pengajuan -->
        <Button
            android:id="@+id/btnKirimBooking"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Kirim Pengajuan Sewa"
            android:backgroundTint="@color/pastel_pink"
            android:textColor="#333333"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>