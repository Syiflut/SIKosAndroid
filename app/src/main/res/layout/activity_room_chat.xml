<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F6">

    <LinearLayout
        android:id="@+id/topBarChat"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentTop="true"
        android:background="#7BB3FF"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvNamaRoomChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Pemilik Kos"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPesan"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBarChat"
        android:layout_above="@id/layoutInputChat"
        android:clipToPadding="false"
        android:padding="8dp" />

    <TextView
        android:id="@+id/tvChatKosong"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="Belum ada percakapan baru."
        android:textColor="#A0A0A0"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutInputChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:elevation="8dp">

        <EditText
            android:id="@+id/etPesanInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@android:drawable/edit_text"
            android:backgroundTint="#F0F4F8"
            android:hint="Ketik pesan..."
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:maxLines="4" />

        <Button
            android:id="@+id/btnKirimPesan"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#FFB6C1"
            android:text="Kirim"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>