<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp">

    <!-- Judul Halaman -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Riwayat Sewa &amp; Pembayaran"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/pastel_blue_dark"
        android:layout_marginBottom="16dp" />

    <!-- Daftar Riwayat Transaksi -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRiwayatPembayaran"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginVertical="12dp"/>

    <!-- AREA BARU: Form Upload Bukti Pembayaran -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upload Bukti Pembayaran"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>

        <!-- Tombol Pilih Gambar -->
        <Button
            android:id="@+id/btnPilihGambar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih Bukti Transaksi (Galeri)"
            android:backgroundTint="#FFB6C1"
            android:textColor="#FFFFFF" />

        <!-- Teks Status Indikator Gambar -->
        <TextView
            android:id="@+id/tvStatusGambar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Belum ada berkas dipilih"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginTop="4dp"
            android:layout_gravity="center_horizontal" />

        <!-- Tombol Kirim Ke Admin -->
        <Button
            android:id="@+id/btnKirimBukti"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kirim Bukti Pembayaran"
            android:backgroundTint="@color/pastel_blue_dark"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</LinearLayout>