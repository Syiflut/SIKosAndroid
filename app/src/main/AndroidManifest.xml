<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".SIKosApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SIKosAndroid">
        <activity android:name=".feature_auth.LoginActivity"
            android:exported="true">
            <meta-data
                android:name="android.app.searchable"
                android:value="true" />
            <meta-data
                android:name="android.app.taskAffinity"
                android:value=".SIKosApp" />
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".SIKosApp" />
            <meta-data
                android:name="android.support.PARENT_STACKS"
                android:value="true" />
            <meta-data
                android:name="android.support.PARENT_AS_ROOT"
                android:value="true" />
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
    </activity>
    </application>

</manifest>